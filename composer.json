{
  "name": "wexample/symfony-api-ds",
  "description": "Design-system screens for symfony-api: a person's api tokens, listed with their last use, issued with their secret shown once, revoked",
  "version": "2.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyApiDs\\": "src/"
    }
  },
  "require": {
    "php": ">=8.5",
    "wexample/symfony-api": ">=17.0.0",
    "wexample/symfony-user-ds": ">=9.0.0",
    "wexample/symfony-design-system": ">=43.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=27.0.0",
    "wexample/symfony-forms": ">=16.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}